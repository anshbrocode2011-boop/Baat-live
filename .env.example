# JWT_SECRET: Secret key for signing and verifying JSON Web Tokens (JWT) for user auth.
# In production, use a strong random secret (e.g. `openssl rand -hex 32`).
JWT_SECRET="your-super-secret-jwt-key"

# DATABASE_URL: PostgreSQL connection string.
# Example: postgresql://user:password@localhost:5432/baat
# If not provided, the server automatically runs in resilient in-memory mode.
DATABASE_URL="postgresql://user:password@localhost:5432/baat"

# PORT: Server port (defaults to 3000 in development).
PORT=3000

# CLIENT_ORIGIN: Allowed origins for CORS in production (comma-separated or single domain).
# Example: https://baat.onrender.com
CLIENT_ORIGIN="http://localhost:3000"

# VITE_API_BASE_URL: (Optional) Frontend API base URL.
# Leave blank when frontend and backend are served from the same domain/port.
VITE_API_BASE_URL=""

# GEMINI_API_KEY: Required only if Gemini AI capabilities are enabled.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted on Cloud Run / AI Studio.
APP_URL="MY_APP_URL"
